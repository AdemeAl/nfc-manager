# Mot de passe pour accéder au dashboard admin (choisis-en un solide)
ADMIN_PASSWORD=change_moi

# Ces deux variables sont ajoutées AUTOMATIQUEMENT par Vercel
# quand tu connectes une base Upstash Redis (voir README.md)
# NOTE: selon la version de l'intégration Vercel, elles peuvent être préfixées
# différemment (ex: STORAGE_KV_REST_API_URL). Vérifie les noms exacts dans
# Vercel > Settings > Environment Variables et adapte lib/redis.js si besoin.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Clé API Google Places, pour la recherche automatique du lien d'avis Google
# (voir section dédiée dans le README pour l'obtenir)
GOOGLE_PLACES_API_KEY=
